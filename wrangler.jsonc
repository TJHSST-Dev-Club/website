{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tjdev-club",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "tjdev.club/*",
      "zone_name": "tjdev.club"
    }
  ]
}
